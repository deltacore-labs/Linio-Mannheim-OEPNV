// Debug.xcconfig

// Wallet defaults - werden von Secrets.xcconfig überschrieben falls vorhanden
WALLET_PASS_TYPE_ID =
WALLET_TEAM_ID =
WALLET_CERT_NAME =
WALLET_CERT_PASSWORD =
WALLET_AUTH_TOKEN =

// Secrets.xcconfig enthält die echten Werte (nicht im Git!)
#include? "Secrets.xcconfig"

// Debug-spezifische Build Settings
DEBUG_INFORMATION_FORMAT = dwarf-with-dsym
ENABLE_BITCODE = NO
SWIFT_OPTIMIZATION_LEVEL = -Onone
SWIFT_ACTIVE_COMPILATION_CONDITIONS = DEBUG
GCC_PREPROCESSOR_DEFINITIONS = DEBUG=1 $(inherited)
ENABLE_TESTABILITY = YES

// RNV Specific
PRODUCT_BUNDLE_IDENTIFIER = com.stefanfriedrich.rnvapp
