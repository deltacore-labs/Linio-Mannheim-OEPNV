// Release.xcconfig

// Wallet defaults - werden von Secrets.xcconfig überschrieben falls vorhanden
WALLET_PASS_TYPE_ID =
WALLET_TEAM_ID =
WALLET_CERT_NAME =
WALLET_CERT_PASSWORD =
WALLET_AUTH_TOKEN =

// Secrets.xcconfig enthält die echten Werte (nicht im Git!)
#include? "Secrets.xcconfig"

// Release-spezifische Build Settings
DEBUG_INFORMATION_FORMAT = dwarf-with-dsym
ENABLE_BITCODE = YES
SWIFT_OPTIMIZATION_LEVEL = -O
SWIFT_ACTIVE_COMPILATION_CONDITIONS = RELEASE
ENABLE_TESTABILITY = NO

// RNV Specific
PRODUCT_BUNDLE_IDENTIFIER = com.stefanfriedrich.rnvapp
