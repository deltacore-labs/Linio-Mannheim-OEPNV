// Secrets.xcconfig.example
// Kopiere diese Datei als "Secrets.xcconfig" und fülle die Werte aus
// NIEMALS die echte Secrets.xcconfig committen!

// Apple Wallet / PassKit
WALLET_PASS_TYPE_ID = pass.com.dein-team.dein-pass
WALLET_TEAM_ID = DEIN_TEAM_ID
WALLET_CERT_NAME = Zertifikat-Name-ohne-p12
WALLET_CERT_PASSWORD = dein-zertifikat-passwort
WALLET_AUTH_TOKEN = dein-auth-token

// RNV API (Rhein-Neckar-Verkehr)
RNV_CLIENT_ID = deine-client-id
RNV_CLIENT_SECRET = dein-client-secret
RNV_TENANT_ID = deine-tenant-id
RNV_RESOURCE = deine-resource-id
RNV_GRAPHQL_URL = https://deine-graphql-url/
RNV_APP_GROUP_ID = group.com.dein-bundle
RNV_SIGNING_KEY = dein-signing-key


